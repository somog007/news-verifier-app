# Copy to server/.env and fill in. Never commit the real file.
# Where to get the keys and what they cost: docs/SETUP_API_KEYS.md
PORT=8787
# Origin of the frontend allowed to call this server (CORS)
ALLOWED_ORIGIN=http://localhost:5173
# Enables /api/verify (AI research). Optional.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Enables published fact-check search in /api/evidence. Free key from Google Cloud. Optional.
GOOGLE_FACTCHECK_API_KEY=
