# Frontend configuration. Copy to .env.local (never commit real keys).
#
# Live evidence server (see server/): news coverage + fact-checks.
# In local dev, /api/* is proxied by Vite to http://localhost:8787.
VITE_EVIDENCE_API_URL=
# AI research endpoint on the same server (needs ANTHROPIC_API_KEY there).
VITE_VERIFY_API_URL=
# Optional: Google Fact Check Tools API key used directly from the browser
# when no server is available. Restrict it to your site's referrer in Google Cloud.
VITE_FACTCHECK_API_KEY=
# Optional: newsfeed endpoint. Defaults to the evidence URL with /evidence replaced by /headlines.
VITE_HEADLINES_API_URL=
